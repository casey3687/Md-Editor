    "@tauri-apps/plugin-opener": "^2.5.3",
    "@uiw/react-codemirror": "^4.25.9",
    "katex": "^0.16.45",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-deflist": "^1.0.0",
    "remark-gfm": "^4.0.1",
