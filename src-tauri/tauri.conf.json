{
  "productName": "Markdown Editor",
  "version": "0.1.0",
  "identifier": "com.casey3687.mdeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": ["icons/icon.ico"]
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Markdown Editor",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true
      }
    ]
  }
}
